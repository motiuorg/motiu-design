    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.0.0",
    "@fontsource-variable/geist": "^5.0.0",
    "@fontsource-variable/geist-mono": "^5.0.0",
    "@fontsource-variable/inter": "^5.0.0",
    "@fontsource/averia-serif-libre": "^5.0.0",
    "@fontsource/ibm-plex-mono": "^5.0.0",
    "d3": "^7.9.0",
    "js-yaml": "^4.1.1"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/js-yaml": "^4.0.9",
    "astro": "^5.0.0",
    "puppeteer-core": "^25.5.0"
  }
