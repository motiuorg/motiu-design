{
  "name": "@motiu/design",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "motiu design system: tokens, themes, Astro components, brand tooling, lab and inspo. Consumed by motiu-website, altiplano-map and future projects.",
