---
// Tab — one tab in a <Tabs> row. Active when `selected` or aria-selected="true" (a page script can
// toggle the attribute). `value` is exposed as data-tab for the page's script to read.
interface Props {
  value?: string;
  selected?: boolean;
  disabled?: boolean;
  class?: string;
  [attr: string]: unknown;
}
const { value, selected = false, disabled = false, class: className, ...rest } = Astro.props;
---
<button
  type="button"
  role="tab"
  class:list={["tab", className]}
  data-tab={value}
  aria-selected={selected ? "true" : "false"}
  disabled={disabled}
  {...rest}
><slot /></button>

<style>
  .tab {
    font-family: var(--mono); font-size: var(--text-xs); text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--text-muted); background: none; border: 0; border-bottom: 2px solid transparent;
    padding: var(--space-3) var(--space-3); margin-bottom: -1px;
    cursor: pointer; white-space: nowrap;
    transition: color var(--t-fast), border-color var(--t-fast);
  }
  .tab:hover:not(:disabled) { color: var(--text-primary); }
  .tab[aria-selected="true"] { color: var(--text-primary); border-bottom-color: var(--text-primary); }
  .tab:focus-visible { outline: 2px solid var(--primary); outline-offset: -2px; }
  .tab:disabled { opacity: 0.4; cursor: default; }

  /* outline — a quiet second level: small tabs, boxed only when active (or hovered). */
  :global(.tabs--outline) .tab {
    min-height: 2rem; padding: 0 var(--space-3); margin-bottom: 0;
    border: 1px solid transparent;
  }
  :global(.tabs--outline) .tab:hover:not(:disabled) { border-color: var(--border-default); }
  :global(.tabs--outline) .tab[aria-selected="true"] { border-color: var(--text-primary); }
  :global(.tabs--outline) .tab:focus-visible { outline-offset: 2px; }

  /* segmented — connected boxes; the active one is filled, like a chip group. */
  :global(.tabs--segmented) { gap: 0; }
  :global(.tabs--segmented) .tab {
    min-height: var(--control-h); padding: 0 var(--space-3); margin-bottom: 0; margin-left: -1px;
    border: 1px solid var(--border-default);
  }
  :global(.tabs--segmented) .tab:first-child { margin-left: 0; }
  :global(.tabs--segmented) .tab[aria-selected="true"] {
    background: var(--text-primary); border-color: var(--text-primary); color: var(--bg);
    position: relative;
  }
  :global(.tabs--segmented) .tab:focus-visible { outline-offset: 2px; }
</style>
