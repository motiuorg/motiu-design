---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/inter";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/averia-serif-libre/400.css";
import "@fontsource/averia-serif-libre/700.css";
import "../styles/tokens.css";
import "../styles/theme.css";
import "../styles/global.css";
import Nav from "./Nav.astro";
import Footer from "./Footer.astro";
import {
    readData,
    getLocales,
    locate,
    currentLang,
    localize,
    baseOf,
    t,
    isInternal,
} from "../lib/site-data.mjs";

type Text = string | Record<string, string>;
// Identity and global meta come from the consuming site's src/data/site.yaml.
// The only required keys are name, url and description; everything else is
// optional (see lib/site-data.mjs for the full list).
const site = readData("site.yaml") as {
    name: string;
    url: string;
    description: Text;
    ogImage?: string;
    ogImageWidth?: number;
    ogImageHeight?: number;
    favicon?: string; // e.g. /favicon.svg, relative to the site root
    titleTemplate?: string; // default "{title} · {name}"
    goatcounter?: string; // e.g. https://<code>.goatcounter.com/count; omit for no analytics
};
const locales = getLocales(readData("site.yaml"));
const baseUrl = import.meta.env.BASE_URL;

interface Props {
    title: string;
    description?: string;
    current?: string; // matches an id in the consumer's nav.yaml
    section?: string; // optional contextual brand-line segment (e.g. "Bioregional Commons")
    dataset?: string; // e.g. "Catalunya"
    minimal?: boolean;
    noindex?: boolean;
    lang?: string; // override the language detected from the URL
}
const detected = locate(Astro.url.pathname, locales, baseUrl);
const loc = Astro.props.lang ?? currentLang(Astro, locales, baseUrl);
const logicalPath = detected.logicalPath;
const {
    title,
    description = t(site.description, loc, locales),
    current = "home",
    section,
    dataset,
    minimal = false,
    noindex = false,
} = Astro.props;
const pageTitle = (site.titleTemplate ?? "{title} · {name}")
    .replace("{title}", title)
    .replace("{name}", site.name);
// i18n: each language page is self-canonical, indexable, and declares hreflang
// alternates for the others (single-language sites declare none).
const canonical = new URL(Astro.url.pathname, site.url).href;
const hrefLang = locales.list.length > 1
    ? locales.list.map((l) => ({
          code: l.code,
          href: new URL(localize(logicalPath, l.code, locales, baseUrl), site.url).href,
      }))
    : [];
const faviconHref = site.favicon
    ? isInternal(site.favicon) ? baseOf(baseUrl) + site.favicon : site.favicon
    : null;
const faviconType = faviconHref?.endsWith(".svg")
    ? "image/svg+xml"
    : faviconHref?.endsWith(".png")
      ? "image/png"
      : undefined;
---

<!doctype html>
<html lang={loc}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        {noindex && <meta name="robots" content="noindex" />}
        <title>{pageTitle}</title>
        {faviconHref && <link rel="icon" type={faviconType} href={faviconHref} />}
        <link rel="canonical" href={canonical} />
        {
            hrefLang.map((l) => (
                <link rel="alternate" hreflang={l.code} href={l.href} />
            ))
        }
        {
            hrefLang.length > 0 && (
                <link
                    rel="alternate"
                    hreflang="x-default"
                    href={new URL(localize(logicalPath, locales.default, locales, baseUrl), site.url).href}
                />
            )
        }
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        {
            site.ogImage && (
                <>
                    <meta
                        property="og:image"
                        content={new URL(baseOf(baseUrl) + site.ogImage, site.url).href}
                    />
                    {site.ogImageWidth && <meta property="og:image:width" content={site.ogImageWidth} />}
                    {site.ogImageHeight && <meta property="og:image:height" content={site.ogImageHeight} />}
                </>
            )
        }
        <meta name="twitter:card" content={site.ogImage ? "summary_large_image" : "summary"} />
        {
            site.goatcounter && (
                <script
                    is:inline
                    data-goatcounter={site.goatcounter}
                    async
                    src="https://gc.zgo.at/count.js"
                />
            )
        }
    </head>
    <body class:list={{ minimal }}>
        {
            !minimal && (
                <Nav current={current} section={section} dataset={dataset} />
            )
        }
        <main class:list={{ "main--overlay-nav": current === "home" }}>
            <slot />
        </main>
        {!minimal && <Footer />}
        <script>
            // Section reveal (iteration 4). Classes are added here, so no-JS
            // visitors get plain static rendering; reduced-motion users get 0ms
            // transitions via the motion tokens.
            const els = document.querySelectorAll(
                "main > section, main > header, main > article",
            );
            if ("IntersectionObserver" in window && els.length) {
                const io = new IntersectionObserver(
                    (entries) => {
                        for (const e of entries) {
                            if (e.isIntersecting) {
                                e.target.classList.add("reveal--in");
                                io.unobserve(e.target);
                            }
                        }
                    },
                    { threshold: 0.08 },
                );
                els.forEach((el) => {
                    el.classList.add("reveal");
                    io.observe(el);
                });
            }
        </script>
    </body>
</html>
