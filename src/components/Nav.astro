---
import LangSwitch from "./LangSwitch.astro";
import { readData, getLocales, currentLang, localize, t, isInternal } from "../lib/site-data.mjs";
// Content comes from the consuming site: name from site.yaml, links from
// nav.yaml ({ label?, items: [{ id, href, label, external? }], cta? }).
const site = readData("site.yaml") as { name: string };
const nav = readData("nav.yaml") as {
    label?: string | Record<string, string>;
    homeLabel?: string | Record<string, string>;
    variant?: "overlay" | "solid";
    items: { id: string; href: string; label: string | Record<string, string>; external?: boolean }[];
    cta?: { id: string; href: string; label: string | Record<string, string> };
};
const locales = getLocales(readData("site.yaml"));
const baseUrl = import.meta.env.BASE_URL;

interface Props {
    current?: string;
    section?: string;
    dataset?: string;
    // overlay: transparent over the hero, gains its background and bottom line
    //   once the page scrolls (motiu.org). solid: background and line from the
    //   very top. Defaults to nav.yaml `variant`, else solid.
    variant?: "overlay" | "solid";
}
const { current = "home", section, dataset } = Astro.props;
const variant = Astro.props.variant ?? nav.variant ?? "solid";
// Keep the chosen language as you navigate: internal links take the current
// language prefix (the default language stays unprefixed).
const loc = currentLang(Astro, locales, baseUrl);
const L = (href: string) => localize(href, loc, locales, baseUrl);
const hrefOf = (it: { href: string; external?: boolean }) =>
    it.external || !isInternal(it.href) ? it.href : L(it.href);
---

<header class:list={["site-nav", { "site-nav--solid": variant === "solid" }]}>
    <a href={L("/")} class="brand" aria-label={`${site.name} — ${t(nav.homeLabel, loc, locales) ?? "home"}`}>
        <span class="brand-org">{site.name}</span>
        {
            section && (
                <>
                    <>
                        <span class="brand-sep">·</span>
                        <span class="brand-system">{section}</span>
                    </>
                </>
            )
        }
        {
            dataset && (
                <>
                    <>
                        <span class="brand-sep">·</span>
                        <span class="brand-dataset">{dataset}</span>
                    </>
                </>
            )
        }
    </a>
    <nav aria-label={t(nav.label, loc, locales) ?? "Primary"}>
        <ul>
            {
                nav.items.map((it) => (
                    <li>
                        <a
                            href={hrefOf(it)}
                            class:list={[{ active: current === it.id }]}
                        >
                            {t(it.label, loc, locales)}
                        </a>
                    </li>
                ))
            }
            {
                nav.cta && (
                    <li>
                        <a
                            href={hrefOf(nav.cta)}
                            class:list={["nav-cta", { active: current === nav.cta.id }]}
                            >{t(nav.cta.label, loc, locales)}</a>
                    </li>
                )
            }
            <li><LangSwitch /></li>
        </ul>
    </nav>
</header>
<script>
    const nav = document.querySelector(".site-nav");
    if (nav) {
        const setNavHeight = () => {
            document.documentElement.style.setProperty(
                "--nav-h",
                `${nav.getBoundingClientRect().height}px`,
            );
        };
        const updateScrolled = () => {
            nav.classList.toggle("is-scrolled", window.scrollY > 8);
        };
        setNavHeight();
        updateScrolled();
        window.addEventListener("resize", setNavHeight);
        window.addEventListener("scroll", updateScrolled, { passive: true });
        // Belt-and-suspenders: web-font swaps and other late layout shifts can
        // trigger a transient browser scroll-anchoring adjustment before the
        // page settles, which the scroll listener latches onto and never
        // un-sets if the position lands back at 0 without another 'scroll'
        // event. Re-check once things are actually done loading.
        window.addEventListener("load", updateScrolled);
        if (document.fonts && document.fonts.ready) {
            document.fonts.ready.then(updateScrolled);
        }
    }
</script>
<style>
    .site-nav {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1rem var(--gutter);
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 20;
        background: transparent;
        border-bottom: 1px solid transparent;
        transition:
            background-color var(--t-med),
            border-color var(--t-med);
    }
    .site-nav.is-scrolled,
    .site-nav--solid {
        background: var(--paper);
        border-bottom-color: var(--border-subtle);
    }
    .brand {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        text-decoration: none;
        color: var(--umber);
        font-family: var(--sans);
        font-size: 1.15rem;
        text-transform: lowercase;
        letter-spacing: -0.01em;
    }
    .brand-org {
        font-weight: 600;
    }
    .brand-system,
    .brand-sep {
        color: var(--rule);
    }
    .brand-dataset {
        color: var(--umber);
    }
    nav ul {
        list-style: none;
        display: flex;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
    }
    nav a {
        font-family: var(--mono);
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--rule);
        text-decoration: none;
        padding: 0.25rem 0;
        border-bottom: 1px solid transparent;
        white-space: nowrap;
    }
    nav a.active,
    nav a:hover {
        color: var(--umber);
        border-bottom-color: var(--umber);
    }
    nav a.nav-cta {
        color: var(--paper);
        background: var(--umber);
        border: 1px solid var(--umber);
        padding: 0.3rem 0.75rem;
        transition:
            background-color var(--t-fast),
            border-color var(--t-fast);
    }
    nav a.nav-cta:hover,
    nav a.nav-cta.active {
        background: var(--rule);
        border-color: var(--rule);
        color: var(--paper);
    }
    @media (max-width: 880px) {
        .brand-system,
        .brand-sep {
            display: none;
        }
    }
    @media (max-width: 720px) {
        .site-nav {
            flex-direction: column;
            align-items: flex-start;
        }
        nav ul {
            gap: 0.9rem;
        }
    }
</style>
