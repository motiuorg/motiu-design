---
import { readData, getLocales, currentLang, localize, t, isInternal } from "../lib/site-data.mjs";
// Content comes from the consuming site: identity from site.yaml, the rest
// from footer.yaml ({ blurb?, columns: [{ label, links: [{ label, url }] }], meta?: [] }).
// Any text may be a per-language map; internal links take the current language.
type Text = string | Record<string, string>;
const site = readData("site.yaml") as { name: string; legalNote?: Text; url: string };
const footer = readData("footer.yaml") as {
    blurb?: Text;
    columns: { label: Text; links: { label: Text; url: string }[] }[];
    meta?: Text[];
};
const locales = getLocales(readData("site.yaml"));
const baseUrl = import.meta.env.BASE_URL;
const loc = currentLang(Astro, locales, baseUrl);
const hrefOf = (url: string) => (isInternal(url) ? localize(url, loc, locales, baseUrl) : url);
const blurb = t(footer.blurb ?? site.legalNote, loc, locales);
const siteHost = new URL(site.url).host;
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="cols">
        <div class="col col--name">
            <span class="lockup">{site.name}</span>
            {blurb && <p>{blurb}</p>}
        </div>
        <div class="col-group">
            {
                footer.columns.map((c) => (
                    <div class="col">
                        <span class="eyebrow">{t(c.label, loc, locales)}</span><ul>
                            {
                                c.links.map((s) => (
                                    <li>
                                        <a href={hrefOf(s.url)}>{t(s.label, loc, locales)}</a>
                                    </li>
                                ))
                            }
                        </ul>
                    </div>
                ))
            }
        </div>
    </div>
    <div class="meta">
        <span>{site.name} · {siteHost} · {year}</span>
        {(footer.meta ?? []).map((m) => <span>{t(m, loc, locales)}</span>)}
    </div>
</footer>
<style>
    .site-footer {
        position: relative;
        isolation: isolate;
        overflow: hidden;
        border-top: 1px solid var(--umber);
        padding: var(--space-12) var(--gutter) var(--space-8);
        background: var(--paper);
        font-family: var(--mono);
        font-size: 0.75rem;
        color: var(--rule);
    }
    .cols,
    .meta {
        position: relative;
        z-index: 1;
    }
    .cols {
        display: flex;
        justify-content: space-between;
        gap: var(--space-8);
        max-width: var(--container-default);
        margin: 0 auto;
    }
    .col-group {
        display: flex;
        gap: var(--space-24);
    }
    .col--name {
        flex-shrink: 0;
    }
    /* Keep a long blurb to a readable measure so it can't push the link
       columns to the far edge. */
    .col--name p {
        max-width: 28rem;
    }
    .lockup {
        font-family: var(--sans);
        font-size: 1.25rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        text-transform: lowercase;
        color: var(--umber);
        display: block;
    }
    .col p {
        margin: var(--space-2) 0 0;
        font-family: var(--sans);
        font-size: var(--copy-sm);
    }
    .col ul {
        list-style: none;
        margin: var(--space-2) 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
    }
    .col a {
        color: var(--rule);
        text-decoration: none;
        font-family: var(--sans);
    }
    .col a:hover {
        color: var(--umber);
    }
    .meta {
        display: flex;
        gap: var(--space-6);
        flex-wrap: wrap;
        max-width: var(--container-default);
        margin: var(--space-10) auto 0;
        padding-top: var(--space-4);
        border-top: 1px dashed var(--rule);
    }
    @media (max-width: 720px) {
        .cols {
            flex-direction: column;
        }
        .col-group {
            flex-wrap: wrap;
        }
    }
</style>
