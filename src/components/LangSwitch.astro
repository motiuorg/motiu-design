---
// LangSwitch — language control for the topbar. Languages come from the
// consuming site's src/data/site.yaml (`locales`); the default language is
// unprefixed, the others live under /<code>/. Links go to the equivalent of
// the current page, so the chosen language persists across the URL. Renders
// nothing for a single-language site.
import { readData, getLocales, locate, currentLang, localize, t } from "../lib/site-data.mjs";
const site = readData("site.yaml");
const locales = getLocales(site);
const baseUrl = import.meta.env.BASE_URL;
const current = currentLang(Astro, locales, baseUrl);
const { logicalPath } = locate(Astro.url.pathname, locales, baseUrl);
const urlFor = (code: string) => localize(logicalPath, code, locales, baseUrl);
const label = t(site.locales?.label, current, locales) ?? "Language";
---
{locales.list.length > 1 && (
<div class="langswitch" role="group" aria-label={label}>
  {locales.list.map((l) => (
    <a
      href={urlFor(l.code)}
      hreflang={l.code}
      class:list={["lang", { on: l.code === current }]}
      aria-current={l.code === current ? "true" : undefined}
    >{l.label}</a>
  ))}
</div>
)}

<style>
  .langswitch { display: inline-flex; align-items: center; gap: 0.15rem; margin-left: 0.4rem; }
  .lang {
    font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--rule); text-decoration: none; padding: 0.2rem 0.35rem; border-radius: var(--radius-sm);
    transition: color var(--t-fast), background-color var(--t-fast);
  }
  .lang:hover { color: var(--umber); }
  .lang.on { color: var(--umber); font-weight: 600; }
  .lang:not(:last-child)::after { content: ""; }
  .lang + .lang { border-left: 1px solid var(--border-subtle); border-radius: 0; }
  .lang:focus-visible { outline: 2px solid var(--primary); outline-offset: 1px; }
</style>
