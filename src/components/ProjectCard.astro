---
// ProjectCard.astro — a project summary card, composed from the card parts (see components/card).
// Same look as before; the project-tile* class names are kept as hooks because pages restyle
// them (e.g. the landing page scales .project-tile__heading).
// Two layouts: stacked (default) and `featured` (image left, larger heading).
import Aurora from "./Aurora.astro";
import Card from "./card/Card.astro";
import CardMedia from "./card/CardMedia.astro";
import CardBody from "./card/CardBody.astro";
import CardBadges from "./card/CardBadges.astro";
import CardTitle from "./card/CardTitle.astro";
import CardEyebrow from "./card/CardEyebrow.astro";
import CardText from "./card/CardText.astro";
import CardFooter from "./card/CardFooter.astro";
import CardLink from "./card/CardLink.astro";

interface Props {
  title: string;
  subtitle?: string; // theme, or "locality · theme" for the cohort variant
  body: string; // excerpt / summary
  image?: string | null;
  href?: string; // omit entirely when there's nowhere to link (e.g. a pending cohort project)
  external?: boolean;
  linkLabel?: string; // overrides the default "Visit site ↗" / "Read case study →"
  mediaPillar?: "tissue" | "neural" | "flow"; // tint for the Aurora fallback when image is null
  featured?: boolean; // image-left/content-right, larger heading. Heading stays plain Geist —
                       // never reach for .display/Averia here, that face is reserved for
                       // hero/page-opening moments (see the Typography page).
}
const { title, subtitle, body, image, href, external = false, linkLabel, mediaPillar = "neural", featured = false } = Astro.props;
const label = linkLabel ?? (external ? "Visit site ↗" : "Read case study →");
---

<Card class:list={["project-tile", { "project-tile--featured": featured }]} layout={featured ? "row" : "stack"}>
  <CardMedia class="project-tile__media" src={image} ratio={featured ? "16 / 9" : "16 / 10"} minHeight="22rem">
    <Aurora pillar={mediaPillar} opacity={0.7} />
  </CardMedia>
  <CardBody class="project-tile__body" padding={featured ? "lg" : "md"}>
    {Astro.slots.has("badges") && (
      <CardBadges class="project-tile__badges"><slot name="badges" /></CardBadges>
    )}
    <CardTitle class="project-tile__heading" size={featured ? "lg" : "md"}>{title}</CardTitle>
    {subtitle && <CardEyebrow class="project-tile__name">{subtitle}</CardEyebrow>}
    <CardText class="project-tile__excerpt">{body}</CardText>
    {href && (
      <CardFooter>
        <CardLink class="project-tile__link" href={href} external={external}>{label}</CardLink>
      </CardFooter>
    )}
  </CardBody>
</Card>
