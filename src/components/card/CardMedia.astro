---
// CardMedia — the picture area of a card. Pass `src`, or put anything (an <Aurora />, an
// illustration) in the slot. In a row card it takes the left half.
interface Props { src?: string | null; alt?: string; ratio?: string }
const { src, alt = "", ratio = "16 / 10" } = Astro.props;
---
<div class="card-media" style={`aspect-ratio: ${ratio};`}>
  {src ? <img src={src} alt={alt} loading="lazy" /> : <slot />}
</div>

<style>
  .card-media { background: var(--surface-2); min-height: 0; position: relative; flex-shrink: 0; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .card-media :global(.aurora) { position: absolute; inset: 0; }
  :global(.card--row) > .card-media { flex: 1.1; aspect-ratio: auto !important; min-height: 16rem; }
</style>
