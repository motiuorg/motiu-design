---
// CardText — body copy: a summary or description, muted.
interface Props { class?: string; [attr: string]: unknown }
const { class: className, ...rest } = Astro.props;
---
<p class:list={["card-text", className]} {...rest}><slot /></p>

<style>
  .card-text { color: var(--text-muted); font-size: var(--copy-md); line-height: var(--leading-body); margin: var(--space-2) 0 0; }
</style>
