---
// Card — the surface every card is built on: paper, soft radius, a hairline border that darkens
// on hover, a faint shadow, and a small lift on hover. It holds no content of its own. Compose a card from the parts in this folder:
//
//   <Card>
//     <CardMedia src="…" />            optional image / aurora, top (or left with layout="row")
//     <CardBody>
//       <CardBadges>…</CardBadges>     pills / tags
//       <CardEyebrow>…</CardEyebrow>   mono caps line (place, theme)
//       <CardTitle>…</CardTitle>
//       <CardText>…</CardText>
//       <CardFacts><CardFact label="…">…</CardFact></CardFacts>   property rows
//       <CardFooter><CardLink href="…">…</CardLink></CardFooter>
//     </CardBody>
//   </Card>
//
// Any extra attribute (data-*, id, class) lands on the surface, so a card can carry the
// attributes a page's filter script needs.
interface Props {
  as?: string;               // element: article (default), div, li — or a when `href` is set
  href?: string;             // makes the whole card a link
  layout?: "stack" | "row";  // row = media beside the body (stacks again on narrow screens)
  interactive?: boolean;     // hover lift and darker border (default true)
  flat?: boolean;            // no shadow — for panels that hold charts and figures (pair with interactive={false})
  class?: string;
  [attr: string]: unknown;
}
const { as, href, layout = "stack", interactive = true, flat = false, class: className, ...rest } = Astro.props;
const Tag = (as ?? (href ? "a" : "article")) as any;
---
<Tag
  class:list={["card", `card--${layout}`, { "card--interactive": interactive, "card--flat": flat }, className]}
  href={href}
  {...rest}
><slot /></Tag>

<style>
  .card {
    display: flex; flex-direction: column; overflow: hidden;
    background: var(--paper); border-radius: var(--radius-card, 0.75rem);
    border: 1px solid var(--border-subtle);
    box-shadow: var(--shadow-sm);
    color: inherit; text-decoration: none;
  }
  .card--interactive { transition: box-shadow var(--t-med), translate var(--t-med), border-color var(--t-med); }
  .card--interactive:hover { border-color: var(--border-default); box-shadow: var(--shadow-md); translate: 0 -2px; }
  .card--flat { box-shadow: none; }
  .card--row { flex-direction: row; }
  @media (max-width: 820px) { .card--row { flex-direction: column; } }
  a.card:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
</style>
