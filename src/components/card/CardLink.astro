---
// CardLink — the small mono-caps link at the bottom of a card. `external` opens a new tab.
interface Props { href: string; external?: boolean; class?: string; [attr: string]: unknown }
const { href, external = false, class: className, ...rest } = Astro.props;
---
<a class:list={["card-link", className]} href={href} {...(external ? { target: "_blank", rel: "noopener" } : {})} {...rest}><slot /></a>

<style>
  .card-link {
    font-family: var(--mono); font-size: var(--text-xs); text-transform: uppercase;
    letter-spacing: 0.05em; color: var(--primary); text-decoration: none;
  }
  .card-link:hover { text-decoration: underline; }
</style>
