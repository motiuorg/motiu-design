---
// CardFacts — a list of labelled properties under a hairline. Fill it with <CardFact>.
// layout="inline": label left, value right (default). layout="stack": label above value,
// for narrow cards.
interface Props { layout?: "inline" | "stack"; rule?: boolean; class?: string; [attr: string]: unknown }
const { layout = "inline", rule = true, class: className, ...rest } = Astro.props;
---
<dl class:list={["card-facts", `card-facts--${layout}`, { "card-facts--rule": rule }, className]} {...rest}><slot /></dl>

<style>
  .card-facts { margin: 0; display: flex; flex-direction: column; gap: var(--space-3); }
  .card-facts--rule { margin-top: var(--space-2); padding-top: var(--space-4); border-top: 1px solid var(--border-subtle); }
  .card-facts--stack > :global(.card-fact) { grid-template-columns: 1fr; gap: var(--space-1); }
</style>
