---
// TeamCard.astro — editorial member tile, composed from the card parts (see components/card).
// Falls back to an Averia monogram over a pillar-tinted aurora header when no portrait is
// supplied. The portraits on file are square, so the picture area is 1 / 1. The team-card*
// class names are kept as hooks because pages restyle them.
import Aurora from "./Aurora.astro";
import Card from "./card/Card.astro";
import CardMedia from "./card/CardMedia.astro";
import CardBody from "./card/CardBody.astro";
import CardTitle from "./card/CardTitle.astro";
import CardEyebrow from "./card/CardEyebrow.astro";
import CardText from "./card/CardText.astro";

interface Props {
  name: string;
  role: string;
  bio?: string;
  pillar?: "neural" | "tissue" | "flow";
  photo?: string;
}
const { name, role, bio, pillar = "tissue", photo } = Astro.props;
const initials = name.split(/\s+/).slice(0, 2).map((w) => w[0]).join("");
---
<Card class="team-card">
  <CardMedia class="team-card__visual" ratio="1 / 1">
    {photo
      ? <img class="team-card__photo" src={photo} alt={name} loading="lazy" />
      : <>
          <Aurora pillar={pillar} opacity={0.7} />
          <span class="team-card__monogram" aria-hidden="true">{initials}</span>
        </>}
  </CardMedia>
  <CardBody class="team-card__body" gap="sm">
    <CardTitle class="team-card__name">{name}</CardTitle>
    <CardEyebrow class="team-card__role" tracking="wide">{role}</CardEyebrow>
    {bio && <CardText class="team-card__bio">{bio}</CardText>}
  </CardBody>
</Card>

<style>
/* The picture area stacks a portrait or a monogram over the aurora. */
:global(.team-card__visual) {
  isolation: isolate;
  overflow: hidden;
  display: grid;
  place-items: center;
}
.team-card__photo {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.team-card__monogram {
  position: relative;
  z-index: 1;
  font-family: var(--serif);
  font-size: var(--text-4xl);
  line-height: 1;
  color: var(--text-primary);
  opacity: 0.85;
}
/* Name, role and bio sit close (CardBody gap="sm"); the role keeps a little air after it. */
:global(.team-card.card .team-card__role.card-eyebrow) { margin: 0 0 var(--space-2); }
</style>
